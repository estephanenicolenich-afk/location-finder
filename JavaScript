// ============================================
// LOCATION FINDER
// Systems Integration Project
// External systems:
//   1. Browser Geolocation API - gets coordinates
//   2. Leaflet + OpenStreetMap - displays map
//   3. Nominatim API - reverse geocoding (address)
// ============================================

// --- DOM references ---
const locateBtn = document.getElementById("locateBtn");
const clearBtn = document.getElementById("clearBtn");
const statusEl = document.getElementById("status");
const resultsEl = document.getElementById("results");
const latEl = document.getElementById("lat");
const lngEl = document.getElementById("lng");
const accuracyEl = document.getElementById("accuracy");
const addressEl = document.getElementById("address");
const timestampEl = document.getElementById("timestamp");

// --- Map state ---
let map = null;
let marker = null;

// ============================================
// INTEGRATION 1: Browser Geolocation API
// ============================================
function findLocation() {
    statusEl.textContent = "Requesting your location...";
    statusEl.className = "status";

    // Check if browser supports geolocation
    if (!navigator.geolocation) {
        statusEl.textContent = "Error: Your browser does not support Geolocation.";
        statusEl.className = "status error";
        return;
    }

    // Request location
    navigator.geolocation.getCurrentPosition(
        onSuccess,   // success callback
        onError,     // error callback
        {
            enableHighAccuracy: true,
            timeout: 10000,
            maximumAge: 0
        }
    );
}

function onSuccess(position) {
    const lat = position.coords.latitude;
    const lng = position.coords.longitude;
    const accuracy = position.coords.accuracy;
    const timestamp = new Date(position.timestamp).toLocaleString();

    // Display coordinates
    latEl.textContent = lat.toFixed(6);
    lngEl.textContent = lng.toFixed(6);
    accuracyEl.textContent = accuracy.toFixed(1);
    timestampEl.textContent = timestamp;

    // Show results panel
    resultsEl.classList.remove("hidden");
    statusEl.textContent = "Location found! Fetching address...";
    statusEl.className = "status";

    // Initialize / update map
    initMap(lat, lng);

    // INTEGRATION 2: Reverse geocoding via Nominatim API
    fetchAddress(lat, lng);
}

function onError(error) {
    let message = "";
    switch (error.code) {
        case error.PERMISSION_DENIED:
            message = "Location access denied. Please allow permission in your browser.";
            break;
        case error.POSITION_UNAVAILABLE:
            message = "Location information is unavailable.";
            break;
        case error.TIMEOUT:
            message = "The request to get your location timed out.";
            break;
        default:
            message = "An unknown error occurred.";
    }
    statusEl.textContent = Error: ${message};
    statusEl.className = "status error";
}

// ============================================
// INTEGRATION 2: Leaflet + OpenStreetMap
// ============================================
function initMap(lat, lng) {
    // Create map if it doesn't exist yet
    if (!map) {
        map = L.map("map").setView([lat, lng], 15);

        // Add OpenStreetMap tiles
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            maxZoom: 19
        }).addTo(map);
    } else {
        map.setView([lat, lng], 15);
    }

    // Add or move marker
    if (marker) {
        marker.setLatLng([lat, lng]);
    } else {
        marker = L.marker([lat, lng]).addTo(map)
            .bindPopup("📍 You are here")
            .openPopup();
    }
}

// ============================================
// INTEGRATION 3: Nominatim Reverse Geocoding API
// ============================================
async function fetchAddress(lat, lng) {
    try {
        addressEl.textContent = "Fetching address...";

        const url = https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng};

        const response = await fetch(url, {
            headers: { "Accept": "application/json" }
        });

        if (!response.ok) {
            throw new Error(API responded with status ${response.status});
        }

        const data = await response.json();

        // Build a readable address from API response
        const addr = data.address;
        const parts = [
            addr.road,
            addr.suburb,
            addr.city || addr.town || addr.municipality,
            addr.state,
            addr.country
        ].filter(Boolean);

        addressEl.textContent = parts.join(", ") || data.display_name;
        statusEl.textContent = "Location found successfully!";
        statusEl.className = "status";

    } catch (error) {
        addressEl.textContent = "Could not fetch address.";
        statusEl.textContent = Address lookup failed: ${error.message};
        statusEl.className = "status error";
        console.error("Reverse geocoding error:", error);
    }
}

// ============================================
// Clear / Reset
// ============================================
function clearAll() {
    resultsEl.classList.add("hidden");
    statusEl.textContent = "Click the button to find your location.";
    statusEl.className = "status";

    if (marker) {
        map.removeLayer(marker);
        marker = null;
    }
}

// ============================================
// EVENT LISTENERS
// ============================================
locateBtn.addEventListener("click", findLocation);
clearBtn.addEventListener("click", clearAll);