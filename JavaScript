// ============================================
// LOCATION FINDER
// Systems Integration Project
//
// External Systems:
// 1. Browser Geolocation API
// 2. Leaflet + OpenStreetMap
// 3. Nominatim Reverse Geocoding API
// ============================================

// ============================================
// DOM REFERENCES
// ============================================

const locateBtn = document.getElementById("locateBtn");
const clearBtn = document.getElementById("clearBtn");

const statusEl = document.getElementById("status");
const resultsEl = document.getElementById("results");

const latEl = document.getElementById("lat");
const lngEl = document.getElementById("lng");
const accuracyEl = document.getElementById("accuracy");
const addressEl = document.getElementById("address");
const timestampEl = document.getElementById("timestamp");

// ============================================
// MAP STATE
// ============================================

let map = null;
let marker = null;
let accuracyCircle = null;

// ============================================
// BUTTON EVENTS
// ============================================

locateBtn.addEventListener("click", findLocation);
clearBtn.addEventListener("click", clearLocation);

// ============================================
// INTEGRATION 1:
// BROWSER GEOLOCATION API
// ============================================

function findLocation() {
    statusEl.textContent = "📡 Requesting your location...";
    statusEl.className = "status";

    locateBtn.disabled = true;
    locateBtn.textContent = "📡 Locating...";

    // Check browser support
    if (!navigator.geolocation) {
        showError("Your browser does not support geolocation.");
        resetLocateButton();
        return;
    }

    navigator.geolocation.getCurrentPosition(
        onSuccess,
        onError,
        {
            enableHighAccuracy: true,
            timeout: 15000,
            maximumAge: 0
        }
    );
}

// ============================================
// SUCCESS
// ============================================

function onSuccess(position) {

    const lat = position.coords.latitude;
    const lng = position.coords.longitude;
    const accuracy = position.coords.accuracy;

    const timestamp = new Date(
        position.timestamp
    ).toLocaleString();

    // Display coordinates
    latEl.textContent = lat.toFixed(6);
    lngEl.textContent = lng.toFixed(6);
    accuracyEl.textContent = accuracy.toFixed(1);
    timestampEl.textContent = timestamp;

    // Show result cards
    resultsEl.classList.remove("hidden");

    statusEl.textContent =
        "✅ Location found! Fetching your address...";

    statusEl.className = "status success";

    // Update map
    initMap(lat, lng, accuracy);

    // Reverse geocode
    fetchAddress(lat, lng);

    resetLocateButton();
}

// ============================================
// LOCATION ERROR
// ============================================

function onError(error) {

    let message;

    switch (error.code) {

        case error.PERMISSION_DENIED:
            message =
                "Location access was denied. Please allow location permission in your browser.";
            break;

        case error.POSITION_UNAVAILABLE:
            message =
                "Your location could not be determined. Please try again.";
            break;

        case error.TIMEOUT:
            message =
                "The location request timed out. Please try again.";
            break;

        default:
            message =
                "An unknown error occurred while finding your location.";
    }

    showError(message);
    resetLocateButton();
}

// ============================================
// ERROR DISPLAY
// ============================================

function showError(message) {

    statusEl.textContent = "❌ " + message;
    statusEl.className = "status error";
}

// ============================================
// RESET BUTTON
// ============================================

function resetLocateButton() {

    locateBtn.disabled = false;
    locateBtn.textContent = "📍 Find My Location";
}

// ============================================
// INTEGRATION 2:
// LEAFLET + OPENSTREETMAP
// ============================================

function initMap(lat, lng, accuracy) {

    // Create map the first time
    if (!map) {

        map = L.map("map").setView(
            [lat, lng],
            16
        );

        // OpenStreetMap tiles
        L.tileLayer(
            "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            {
                attribution:
                    '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',

                maxZoom: 19
            }
        ).addTo(map);

        // Add zoom control
        L.control.zoom({
            position: "topright"
        }).addTo(map);

    } else {

        map.setView(
            [lat, lng],
            16,
            {
                animate: true
            }
        );
    }

    // ========================================
    // LOCATION MARKER
    // ========================================

    if (marker) {

        marker.setLatLng([
            lat,
            lng
        ]);

    } else {

        marker = L.marker([
            lat,
            lng
        ])
        .addTo(map)
        .bindPopup(
            "<strong>📍 You are here</strong>"
        )
        .openPopup();
    }

    // ========================================
    // ACCURACY CIRCLE
    // ========================================

    if (accuracyCircle) {

        accuracyCircle
            .setLatLng([lat, lng])
            .setRadius(accuracy);

    } else {

        accuracyCircle = L.circle(
            [lat, lng],
            {
                radius: accuracy,
                color: "#16a085",
                fillColor: "#1abc9c",
                fillOpacity: 0.15,
                weight: 2
            }
        ).addTo(map);
    }

    // Make sure Leaflet knows the map dimensions
    setTimeout(() => {
        map.invalidateSize();
    }, 200);
}

// ============================================
// INTEGRATION 3:
// NOMINATIM REVERSE GEOCODING API
// ============================================

async function fetchAddress(lat, lng) {

    try {

        addressEl.textContent =
            "📡 Fetching address...";

        const url =
            `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=18&addressdetails=1`;

        const response = await fetch(
            url,
            {
                headers: {
                    "Accept": "application/json"
                }
            }
        );

        if (!response.ok) {

            throw new Error(
                `API responded with status ${response.status}`
            );
        }

        const data = await response.json();

        const addr = data.address || {};

        // Build readable address
        const parts = [

            addr.house_number &&
            addr.road
                ? `${addr.house_number} ${addr.road}`
                : addr.road,

            addr.neighbourhood,

            addr.suburb,

            addr.village,

            addr.town,

            addr.city,

            addr.municipality,

            addr.state,

            addr.country

        ].filter(Boolean);

        const uniqueParts =
            [...new Set(parts)];

        addressEl.textContent =
            uniqueParts.join(", ") ||
            data.display_name ||
            "Address not found.";

        statusEl.textContent =
            "✅ Location and address found!";

        statusEl.className =
            "status success";

    } catch (error) {

        console.error(
            "Error fetching address:",
            error
        );

        addressEl.textContent =
            "Unable to retrieve the address.";

        statusEl.textContent =
            "⚠️ Location found, but the address could not be retrieved.";

        statusEl.className =
            "status error";
    }
}

// ============================================
// CLEAR LOCATION
// ============================================

function clearLocation() {

    // Clear displayed information
    latEl.textContent = "";
    lngEl.textContent = "";
    accuracyEl.textContent = "";
    addressEl.textContent = "";
    timestampEl.textContent = "";

    // Hide result cards
    resultsEl.classList.add("hidden");

    // Remove marker
    if (marker && map) {

        map.removeLayer(marker);
        marker = null;
    }

    // Remove accuracy circle
    if (accuracyCircle && map) {

        map.removeLayer(accuracyCircle);
        accuracyCircle = null;
    }

    // Reset status
    statusEl.textContent =
        "Click the button to find your location.";

    statusEl.className =
        "status";

    // Reset button
    resetLocateButton();

    // Reset map
    if (map) {

        map.setView(
            [20, 0],
            2
        );
    }
}
